---
interface Props {
  src: string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
}

const { src, alt, class: className = '', width = 800, height = 600 } = Astro.props;
---

<img
  src={src}
  alt={alt}
  class={className}
  width={width}
  height={height}
  onerror="this.onerror=null;this.style.display='none';this.nextElementSibling.style.display='flex';"
/>
<div
  class="hidden items-center justify-center bg-[#1a1a1a] border border-[#D4A017]/30 text-[#D4A017]/50 font-oswald text-xs uppercase tracking-widest"
  style={`width:100%;height:100%;min-height:200px;`}
>
  {src.split('/').pop()}
</div>
