---
const currentPath = Astro.url.pathname;

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/residential' },
  { label: 'Flat Roofing', href: '/flat-roofing' },
  { label: 'Reviews', href: '/reviews' },
  { label: 'Free Estimate', href: '/estimate' },
  { label: 'Contact', href: '/contact' },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="bg-[#0a0a0a] border-b border-[#2a2a2a] sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between gap-8">

    <!-- Logo -->
    <a href="/" class="shrink-0">
      <img
        src="/images/golden-star-logo.jpg"
        alt="Golden Star Roofing LLC"
        class="h-12 w-auto object-contain"
        width="120"
        height="48"
      />
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-7">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`font-oswald uppercase tracking-widest text-[13px] transition-colors relative pb-0.5 ${
            isActive(link.href)
              ? 'text-[#D4A017] border-b border-[#D4A017]'
              : 'text-white/70 hover:text-white'
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Desktop CTA -->
    <div class="hidden lg:block shrink-0">
      <a href="/estimate" class="btn-gold whitespace-nowrap">
        Get a Free Estimate
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="lg:hidden text-white/70 hover:text-white p-1 ml-auto"
      aria-label="Toggle navigation"
      aria-expanded="false"
    >
      <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile overlay menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden fixed inset-0 top-16 bg-[#0a0a0a] z-40 flex flex-col"
  >
    <nav class="flex flex-col px-8 pt-10 gap-6">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`font-oswald uppercase tracking-widest text-2xl transition-colors ${
            isActive(link.href)
              ? 'text-[#D4A017]'
              : 'text-white/80 hover:text-white'
          }`}
        >
          {link.label}
        </a>
      ))}
      <div class="mt-4 border-t border-[#2a2a2a] pt-6">
        <a href="/estimate" class="btn-gold inline-block text-center w-full">
          Get a Free Estimate
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
    document.body.style.overflow = isOpen ? '' : 'hidden';
  });
</script>
