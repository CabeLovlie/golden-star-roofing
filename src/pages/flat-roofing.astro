---
import BaseLayout from '../layouts/BaseLayout.astro';
import GoldBanner from '../components/GoldBanner.astro';
---

<BaseLayout
  title="Flat & Low Slope Roofing | Golden Star Roofing LLC — Federal Way, WA"
  description="Commercial and residential flat roofing built for the Pacific Northwest. TPO, modified bitumen, flat roof repair. Free estimates. Licensed and bonded."
  ogImage="/images/golden-star02.jpg"
>

  <!-- HERO -->
  <section
    class="relative min-h-[50vh] flex items-center justify-center text-center"
    style="background-image: url('/images/golden-star02.jpg'); background-size: cover; background-position: center;"
  >
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="relative z-10 px-6 max-w-2xl mx-auto">
      <p class="section-eyebrow mb-4">Commercial &amp; Residential</p>
      <div class="border-t border-[#D4A017] w-12 mx-auto mb-5"></div>
      <h1 class="font-oswald uppercase text-white text-4xl md:text-6xl mb-4">
        Flat &amp; Low Slope Roofing
      </h1>
      <p class="font-inter text-gray-300 text-lg max-w-lg mx-auto leading-relaxed">
        Commercial and residential flat roofing built for the Pacific Northwest.
      </p>
    </div>
  </section>

  <!-- SERVICES DETAIL -->
  <section class="bg-[#0a0a0a] py-20 px-6">
    <div class="max-w-5xl mx-auto space-y-20">

      <!-- TPO Roofing -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div>
          <p class="section-eyebrow mb-3">Energy Efficient</p>
          <h2 class="font-oswald uppercase text-white text-3xl mb-4">TPO Roofing</h2>
          <div class="border-t border-[#D4A017] w-10 mb-5"></div>
          <p class="font-inter text-text-muted text-sm leading-relaxed mb-4">
            Thermoplastic polyolefin (TPO) is the modern standard for flat and low-slope commercial roofing. Single-ply, heat-welded seams, and a reflective white surface that reduces cooling costs.
          </p>
          <p class="font-inter text-text-muted text-sm leading-relaxed mb-6">
            Ideal for commercial buildings, low-slope residential additions, and multi-family properties. Brandon's crew installs TPO to manufacturer specifications with full warranty coverage.
          </p>
          <a href="/estimate" class="btn-gold inline-block">Get a Free Estimate</a>
        </div>
        <div class="h-72 md:h-96 overflow-hidden">
          <img
            src="/images/golden-star15.jpg"
            alt="TPO flat roofing installation"
            class="w-full h-full object-cover"
            width="700"
            height="500"
            onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
          />
          <div class="hidden w-full h-full items-center justify-center bg-[#1a1a1a] border border-[#D4A017]/30 text-[#D4A017]/40 font-oswald text-xs uppercase tracking-widest">golden-star15.jpg</div>
        </div>
      </div>

      <div class="border-t border-[#2a2a2a]"></div>

      <!-- Modified Bitumen -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div class="order-2 md:order-1 h-72 md:h-96 overflow-hidden">
          <img
            src="/images/golden-star16.jpg"
            alt="Modified bitumen roofing"
            class="w-full h-full object-cover"
            width="700"
            height="500"
            onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
          />
          <div class="hidden w-full h-full items-center justify-center bg-[#1a1a1a] border border-[#D4A017]/30 text-[#D4A017]/40 font-oswald text-xs uppercase tracking-widest">golden-star16.jpg</div>
        </div>
        <div class="order-1 md:order-2">
          <p class="section-eyebrow mb-3">Built to Last</p>
          <h2 class="font-oswald uppercase text-white text-3xl mb-4">Modified Bitumen</h2>
          <div class="border-t border-[#D4A017] w-10 mb-5"></div>
          <p class="font-inter text-text-muted text-sm leading-relaxed mb-4">
            Multi-layer modified bitumen systems are engineered for heavy rainfall and temperature swings — which describes the PNW perfectly. Torch-applied or self-adhering, these systems provide superior puncture resistance and long-term waterproofing.
          </p>
          <p class="font-inter text-text-muted text-sm leading-relaxed mb-6">
            A proven system that's been protecting flat roofs for decades. When you need serious protection with a long track record, modified bitumen delivers.
          </p>
          <a href="/estimate" class="btn-gold inline-block">Get a Free Estimate</a>
        </div>
      </div>

      <div class="border-t border-[#2a2a2a]"></div>

      <!-- Flat Roof Repair -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div>
          <p class="section-eyebrow mb-3">Fast Response</p>
          <h2 class="font-oswald uppercase text-white text-3xl mb-4">Flat Roof Repair</h2>
          <div class="border-t border-[#D4A017] w-10 mb-5"></div>
          <p class="font-inter text-text-muted text-sm leading-relaxed mb-4">
            Flat roof leaks are deceptive — water travels before it shows. Brandon's crew has the experience to find the actual source and fix it properly, not just chase the drip.
          </p>
          <p class="font-inter text-text-muted text-sm leading-relaxed mb-6">
            Membrane patching, drain clearing, seam repair, and emergency leak response. If your flat roof is letting water in, don't wait for the next rainstorm.
          </p>
          <a href="tel:2068839841" class="btn-gold inline-block">Call for Fast Response</a>
        </div>
        <div class="h-72 md:h-96 overflow-hidden">
          <img
            src="/images/golden-star17.jpg"
            alt="Flat roof repair"
            class="w-full h-full object-cover"
            width="700"
            height="500"
            onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
          />
          <div class="hidden w-full h-full items-center justify-center bg-[#1a1a1a] border border-[#D4A017]/30 text-[#D4A017]/40 font-oswald text-xs uppercase tracking-widest">golden-star17.jpg</div>
        </div>
      </div>

    </div>
  </section>

  <!-- WHY FLAT ROOFING MATTERS IN PNW -->
  <section class="bg-[#141414] border-t border-[#2a2a2a] py-16 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <p class="section-eyebrow mb-4">Pacific Northwest Context</p>
      <div class="border-t border-[#D4A017] w-12 mx-auto mb-5"></div>
      <h2 class="font-oswald uppercase text-white text-3xl mb-5">Flat Roofs in a Wet Climate</h2>
      <p class="font-inter text-text-muted text-sm leading-relaxed mb-4">
        The Pacific Northwest gets 37+ inches of rain per year in Federal Way alone. Flat roofs require proper drainage design, quality membranes, and regular maintenance to perform. A contractor who doesn't understand standing water is a contractor who creates problems.
      </p>
      <p class="font-inter text-text-muted text-sm leading-relaxed">
        Brandon has been installing and servicing flat roofs in King County for 13 years. He knows what works here — and what doesn't.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <GoldBanner />

</BaseLayout>
