---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewCard from '../components/ReviewCard.astro';
import GoldBanner from '../components/GoldBanner.astro';
---

<BaseLayout
  title="Golden Star Roofing LLC | Federal Way, WA Roofing Contractor"
  description="Federal Way's trusted roofing contractor. 14+ years. Licensed, insured, and bonded. CertainTeed specialist. 15–25 year workmanship warranties. Free estimates for King County homeowners."
>

  <!-- HERO -->
  <section
    class="relative min-h-[85vh] flex items-center justify-center text-center"
    style="background-image: url('/images/golden-star01.jpg'); background-size: cover; background-position: center;"
  >
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="relative z-10 px-6 max-w-3xl mx-auto">
      <img
        src="/images/golden-star-logo.jpg"
        alt="Golden Star Roofing LLC"
        class="h-24 w-auto object-contain mx-auto mb-6"
        width="240"
        height="96"
      />
      <div class="border-t border-[#D4A017] w-16 mx-auto mb-6"></div>
      <h1 class="font-oswald uppercase text-white text-5xl md:text-7xl leading-tight mb-4">
        Federal Way's<br />Trusted Roofer
      </h1>
      <p class="font-inter text-gray-300 text-lg md:text-xl mb-6 max-w-xl mx-auto leading-relaxed">
        14 Years. Licensed &amp; Bonded. Every Job Backed by a 5-Star Reputation.
      </p>
      <div class="border-t border-[#D4A017] w-16 mx-auto mb-8"></div>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/estimate" class="btn-gold text-base px-8 py-4">
          Get a Free Estimate
        </a>
        <a href="tel:2068839841" class="btn-gold-outline text-base px-8 py-4">
          Call (206) 883-9841
        </a>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="bg-[#141414] border-b border-[#2a2a2a] py-5 px-6">
    <div class="max-w-5xl mx-auto flex flex-wrap justify-center items-center gap-8 md:gap-12">
      {[
        { icon: '★', text: 'Perfect 5-Star Rating on Google' },
        { icon: '✓', text: 'Licensed & Bonded' },
        { icon: '⌂', text: '14+ Years Experience' },
      ].map(badge => (
        <div class="flex items-center gap-2.5">
          <span class="text-[#D4A017] text-base leading-none">{badge.icon}</span>
          <span class="font-oswald uppercase tracking-widest text-white text-xs whitespace-nowrap">{badge.text}</span>
        </div>
      ))}
      <!-- Warranty badge with half-gold / half-black shield SVG -->
      <div class="flex items-center gap-2.5">
        <svg width="14" height="16" viewBox="0 0 14 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink:0;">
          <defs>
            <clipPath id="shield-left">
              <rect x="0" y="0" width="7" height="16" />
            </clipPath>
            <clipPath id="shield-right">
              <rect x="7" y="0" width="7" height="16" />
            </clipPath>
          </defs>
          <!-- Shield path: left half gold fill -->
          <path d="M7 1L1.5 3.5V8C1.5 11.5 4 14 7 15C10 14 12.5 11.5 12.5 8V3.5L7 1Z" fill="#D4A017" clip-path="url(#shield-left)" />
          <!-- Shield path: right half black fill -->
          <path d="M7 1L1.5 3.5V8C1.5 11.5 4 14 7 15C10 14 12.5 11.5 12.5 8V3.5L7 1Z" fill="#141414" clip-path="url(#shield-right)" />
          <!-- Full shield outline in gold -->
          <path d="M7 1L1.5 3.5V8C1.5 11.5 4 14 7 15C10 14 12.5 11.5 12.5 8V3.5L7 1Z" stroke="#D4A017" stroke-width="1" stroke-linejoin="round" fill="none" />
        </svg>
        <span class="font-oswald uppercase tracking-widest text-white text-xs whitespace-nowrap">15–25 Year Workmanship Warranty</span>
      </div>
    </div>
  </section>

  <!-- SERVICES SNAPSHOT -->
  <section class="bg-[#0a0a0a] py-20 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <p class="section-eyebrow">What We Do</p>
        <div class="border-t border-[#D4A017] w-12 mx-auto mb-5"></div>
        <h2 class="font-oswald uppercase text-white text-3xl md:text-4xl">
          Residential &amp; Commercial Roofing Done Right
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-0 border border-[#2a2a2a]">
        <!-- Card 1 -->
        <div class="bg-[#1a1a1a] border-r border-[#2a2a2a] flex flex-col">
          <div class="h-52 overflow-hidden">
            <img
              src="/images/golden-star03.jpg"
              alt="Residential roofing"
              class="w-full h-full object-cover"
              width="600"
              height="400"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
            />
            <div class="hidden h-52 items-center justify-center bg-[#111] text-[#D4A017]/40 font-oswald text-xs uppercase tracking-widest">golden-star03.jpg</div>
          </div>
          <div class="border-t border-[#D4A017]"></div>
          <div class="p-6 flex flex-col flex-1">
            <h3 class="font-oswald uppercase text-white text-lg mb-3">Residential Roofing</h3>
            <p class="font-inter text-text-muted text-sm leading-relaxed flex-1">
              CertainTeed &amp; Malarkey shingles. Full replacements, storm repairs, and inspections for homeowners across King County.
            </p>
            <a href="/services" class="text-[#D4A017] font-oswald uppercase tracking-widest text-xs mt-5 hover:text-[#F0B820] transition-colors">
              Learn More &rarr;
            </a>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="bg-[#1a1a1a] border-r border-[#2a2a2a] flex flex-col">
          <div class="h-52 overflow-hidden">
            <img
              src="/images/golden-star22.webp"
              alt="Roof repairs"
              class="w-full h-full object-cover"
              width="600"
              height="400"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
            />
            <div class="hidden h-52 items-center justify-center bg-[#111] text-[#D4A017]/40 font-oswald text-xs uppercase tracking-widest">golden-star22.webp</div>
          </div>
          <div class="border-t border-[#D4A017]"></div>
          <div class="p-6 flex flex-col flex-1">
            <h3 class="font-oswald uppercase text-white text-lg mb-3">Roof Repairs</h3>
            <p class="font-inter text-text-muted text-sm leading-relaxed flex-1">
              Leak detection, flashing, storm damage — fast turnaround so your home stays protected. Most repairs completed same-day or next-day.
            </p>
            <a href="/services" class="text-[#D4A017] font-oswald uppercase tracking-widest text-xs mt-5 hover:text-[#F0B820] transition-colors">
              Learn More &rarr;
            </a>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="bg-[#1a1a1a] flex flex-col">
          <div class="h-52 overflow-hidden">
            <img
              src="/images/golden-star04.jpg"
              alt="Free estimates"
              class="w-full h-full object-cover"
              width="600"
              height="400"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
            />
            <div class="hidden h-52 items-center justify-center bg-[#111] text-[#D4A017]/40 font-oswald text-xs uppercase tracking-widest">golden-star04.jpg</div>
          </div>
          <div class="border-t border-[#D4A017]"></div>
          <div class="p-6 flex flex-col flex-1">
            <h3 class="font-oswald uppercase text-white text-lg mb-3">Free Estimates</h3>
            <p class="font-inter text-text-muted text-sm leading-relaxed flex-1">
              No-pressure, on-site estimates at no charge. Brandon walks the roof himself and gives you straight answers before any commitment.
            </p>
            <a href="/estimate" class="text-[#D4A017] font-oswald uppercase tracking-widest text-xs mt-5 hover:text-[#F0B820] transition-colors">
              Request Estimate &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PHOTO STRIP -->
  <section class="bg-[#0a0a0a] border-t border-[#2a2a2a]">
    <div class="flex overflow-x-auto scrollbar-hide">
      {['golden-star05.jpg','golden-star06.jpg','golden-star07.jpg','golden-star08.jpg','golden-star09.jpg','golden-star10.jpg'].map(photo => (
        <div class="flex-none w-72 md:w-80 h-64 overflow-hidden">
          <img
            src={`/images/${photo}`}
            alt="Golden Star Roofing project"
            class="w-full h-full object-cover"
            width="400"
            height="256"
            onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
          />
          <div class="hidden w-full h-64 items-center justify-center bg-[#111] border-r border-[#2a2a2a] text-[#D4A017]/30 font-oswald text-xs uppercase tracking-widest">{photo}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- WHY GOLDEN STAR -->
  <section class="bg-[#141414] border-t border-[#2a2a2a] py-20 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <p class="section-eyebrow">Why Us</p>
        <div class="border-t border-[#D4A017] w-12 mx-auto mb-5"></div>
        <h2 class="font-oswald uppercase text-white text-3xl md:text-4xl">Why Golden Star</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-14">
        <div>
          <div class="text-[#D4A017] text-3xl mb-4">⬡</div>
          <h3 class="font-oswald uppercase text-white text-lg mb-3">Honest Service</h3>
          <p class="font-inter text-text-muted text-sm leading-relaxed">
            No surprise charges, no pressure. Clear quotes and reliable communication from the first call to the final nail.
          </p>
        </div>
        <div>
          <div class="text-[#D4A017] text-3xl mb-4">◈</div>
          <h3 class="font-oswald uppercase text-white text-lg mb-3">Quality Materials</h3>
          <p class="font-inter text-text-muted text-sm leading-relaxed">
            CertainTeed products on every job. Built for the Pacific Northwest and backed by 15–25 year workmanship warranties depending on the system installed.
          </p>
        </div>
        <div>
          <div class="text-[#D4A017] text-3xl mb-4">★</div>
          <h3 class="font-oswald uppercase text-white text-lg mb-3">Family-Owned</h3>
          <p class="font-inter text-text-muted text-sm leading-relaxed">
            Brandon and his crew have been roofing Washington homes for over 14 years. Every job gets the same care they'd give their own roof.
          </p>
        </div>
      </div>

      <!-- Owner quote block -->
      <div class="bg-[#1a1a1a] border-l-4 border-[#D4A017] px-8 py-7">
        <p class="font-inter italic text-white/90 text-base leading-relaxed mb-4">
          &ldquo;Family-owned roofing company with over 14 years of experience providing high-quality roofing services throughout Washington. We take pride in delivering reliable workmanship, honest service, and long-lasting results — and we back it with a 15 to 25-year workmanship warranty on every project.&rdquo;
        </p>
        <p class="font-oswald uppercase tracking-widest text-[#D4A017] text-xs">
          Brandon &mdash; Owner, Golden Star Roofing LLC
        </p>
      </div>
    </div>
  </section>

  <!-- REVIEWS SNAPSHOT -->
  <section class="bg-[#0a0a0a] border-t border-[#2a2a2a] py-20 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <p class="section-eyebrow">What Customers Say</p>
        <div class="border-t border-[#D4A017] w-12 mx-auto mb-5"></div>
        <h2 class="font-oswald uppercase text-white text-3xl md:text-4xl">11 Reviews. Every One a 5-Star.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
        <ReviewCard
          quote="Brandon came out the same week I called, gave me a straight quote, and his crew knocked out the full replacement in two days. Zero mess left behind. Can't say enough good things."
          reviewer="M. Thompson"
          city="Federal Way, WA"
        />
        <ReviewCard
          quote="Had a leak that two other contractors couldn't find. Brandon located it in 20 minutes, fixed the flashing the same day, and charged a fair price. This is who you call."
          reviewer="J. Caldwell"
          city="Kent, WA"
        />
        <ReviewCard
          quote="Golden Star did our flat roof on a small commercial property. Clean work, on schedule, and they used quality materials. Three years in and not a single issue."
          reviewer="D. Hernandez"
          city="Renton, WA"
        />
      </div>

      <div class="text-center">
        <a href="/reviews" class="text-[#D4A017] font-oswald uppercase tracking-widest text-sm hover:text-[#F0B820] transition-colors">
          See All Reviews &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <GoldBanner />

</BaseLayout>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>
